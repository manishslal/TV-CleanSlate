#!/bin/sh
# Free memory: stop LG's app preloading and services for features this TV does not use.
# Everything here lasts until the next boot. Undo: rm /var/lib/webosbrew/init.d/17-lg-slim and restart the TV.
(
  export PATH=/usr/bin:/usr/sbin:/bin:/sbin:$PATH
  sleep 80
  [ -e /media/developer/cleanyourtv/DISABLE-SLIM ] && exit 0
  systemctl --no-block stop preload-manager.service broadcast-conf-downloader.service rec-info-adapter.service rec-listmgr.service tv-reservation-agent.service lgchannelurl.service
  for id in netflix youtube.leanback.v4; do
    fg=$(luna-send -n 1 -w 5000 luna://com.webos.applicationManager/getForegroundAppInfo '{}' </dev/null)
    case "$fg" in *"\"$id\""*) ;; *) luna-send -n 1 -w 5000 luna://com.webos.applicationManager/closeByAppId "{\"id\":\"$id\"}" </dev/null >/dev/null 2>&1 ;; esac
  done
  # on-demand services for HomeKit and LG's cloud link: a do-nothing stub keeps the bus from starting them
  for b in homekit mqtt-client; do
    for p in /usr/bin/$b /usr/sbin/$b; do
      [ -e "$p" ] || continue
      grep -q " $p " /proc/mounts || mount --bind /media/developer/cleanyourtv/stub-noop "$p"
    done
    pkill -9 -x $b
  done
  # LG's voice app ("Search", the remote's mic button), taken out at the owner's request: about 14 MB
  # held and 10 MB more in swap. Its name is longer than pkill -x reads, so it is matched by path.
  v=/usr/bin/com.webos.app.voice
  if [ -e "$v" ]; then
    grep -q " $v " /proc/mounts || mount --bind /media/developer/cleanyourtv/stub-noop "$v"
    pkill -9 -f "^$v"
  fi
) </dev/null >/dev/null 2>&1 &
