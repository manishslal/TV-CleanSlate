    <string name="wp_weather_city">Місцезнаходження</string>
    <string name="st_home_standard">Два ряди</string>
    <string name="st_home_one_row">Один ряд</string>
    <string name="st_home_layout_hint">«Один ряд» показує на екрані лише верхній ряд, нижче, щоб було видно більше шпалер, наприклад родинного фото. «Два ряди» показує ще верх другого ряду. Натисніть вниз, щоб побачити решту.</string>
    <string name="st_plate">Верхній ряд</string>
    <string name="st_plate_hint">Підкладка з матового скла під верхнім рядом, як на Apple TV, або застосунки просто на шпалерах.</string>
    <string name="st_plate_glass">Скло</string>
    <string name="st_plate_none">Немає</string>
    <string name="st_sounds">Звуки</string>
    <string name="st_sounds_hint">Звук під час переміщення фокуса, вибору та натискання «Назад», як на Apple TV.</string>
    <string name="st_sounds_tv_hint">Власні звуки клавіш телевізора, як у його меню. Якщо їх вимкнено в налаштуваннях телевізора, звуку не буде: тоді виберіть Home.</string>
    <string name="st_sounds_tv">ТВ</string>
    <string name="st_sounds_aerial">Home</string>
    <string name="st_on">Увімк.</string>
    <string name="st_off">Вимк.</string>
    <string name="st_hidden_apps">Приховані застосунки</string>
    <string name="st_hidden_apps_hint">Застосунки, приховані з головного екрана, зберігаються тут, щоб їх можна було повернути. Якщо задано батьківський PIN-код, спочатку його буде запитано.</string>
    <string name="st_hidden_none">Немає</string>
    <string name="st_hidden_count">%d</string>
    <string name="st_focus_high">Високий контраст</string>
    <string name="st_focus_standard">Стандартний</string>
    <string name="st_focus_high_hint">Біла рамка навколо вибраного застосунку, добре помітна з іншого кінця кімнати.</string>
    <string name="st_focus_standard_hint">Як на Apple TV з коробки: вибраний застосунок лише трохи підіймається.</string>
    <string name="cc_inputs_settings">Налаштування джерел</string>
    <string name="cc_inputs_pin">Показувати на головному екрані (будь-яка кількість)</string>
    <string name="cc_inputs_boot">Під час вмикання телевізора (одне)</string>
    <string name="cc_inputs_boot_none">Нічого, залишатися в Home</string>
    <string name="cc_inputs_boot_hint">Перемикатися на це джерело під час вмикання телевізора або виходу зі сну. Кнопка «Додому» все одно повертає в Home.</string>
    <string name="cc_inputs_pin_hint">Закріплені джерела з’являються плитками на початку головного екрана; виберіть одне, щоб одразу перемкнутися. Утримуйте плитку, щоб перемістити або прибрати її.</string>
